{% if things.size > 0 %}
{% assign functions_title = schema_id | append: " function definitions" %}

{% include "basic_title", thing_prefix: thing_prefix, anchor: "functions", title: functions_title, depth: depth %}

{% for thing in things %}
{% assign function_nested_depth = depth | plus: 1 %}

{% include "function", thing: thing, thing_prefix: thing_prefix, depth: function_nested_depth %}

{% endfor %}

{% endif %}
