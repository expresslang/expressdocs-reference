{% assign entity_nested_depth = depth %}
{% include "basic_thing", depth: entity_nested_depth, thing_prefix: thing_prefix, thing: thing %}

{% if thing.attributes.size > 0 %}
{% capture entity_thing_prefix %}{{thing_prefix}}.{{thing.id}}{% endcapture %}

{% include "entity_attributes", things: thing.attributes, thing_prefix: entity_thing_prefix, depth: entity_nested_depth %}

{% endif %}

{% if thing.where_rules.size > 0 %}
{% capture entity_thing_prefix %}{{thing_prefix}}.{{thing.id}}{% endcapture %}

{% include "entity_where_rules", things: thing.where_rules, thing_prefix: entity_thing_prefix, depth: entity_nested_depth %}

{% endif %}

