{% capture rule_thing_prefix %}{{thing_prefix}}.{{thing.id}}{% endcapture %}

{% assign rule_nested_depth = depth | plus: 1 %}

{% include "basic_thing", depth: rule_nested_depth, thing_prefix: rule_thing_prefix, thing: thing %}

{% if thing.types.size > 0 %}
{% include "types", things: thing.types, thing_prefix: rule_thing_prefix, depth: rule_nested_depth %}

{% endif %}

{% if thing.constants.size > 0 %}
{% include "function_constants", things: thing.constants, thing_prefix: rule_thing_prefix, depth: rule_nested_depth %}

{% endif %}

{% if thing.variables.size > 0 %}
{% include "function_variables", things: thing.variables, thing_prefix: rule_thing_prefix, depth: rule_nested_depth %}

{% endif %}

{% if thing.statements.size > 0 %}
{% include "statements", things: thing.statements, thing_prefix: function_rule_thing_prefix, depth: rule_nested_depth %}

{% endif %}

{% if thing.where.size > 0 %}
{% include "where", thing_prefix: rule_thing_prefix, things: thing.where, depth: rule_nested_depth %}

{% endif %}
