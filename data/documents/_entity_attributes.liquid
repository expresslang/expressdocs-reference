{% if things.size > 0 %}
{% assign ea_nested_depth = depth | plus: 1 %}

{% include "basic_title", thing_prefix: thing_prefix, anchor: "attributes", title: "Attributes", depth: ea_nested_depth %}

{% for thing in things %}
{% assign eaa_nested_depth = ea_nested_depth | plus: 1 %}

{% if thing.id %}
{% include "basic_thing", thing: thing, thing_prefix: thing_prefix, depth: eaa_nested_depth %}
{% else %}
{% include "basic_derived_thing", thing: thing, thing_prefix: thing_prefix, depth: eaa_nested_depth %}
{% endif %}

{% endfor %}

{% endif %}
