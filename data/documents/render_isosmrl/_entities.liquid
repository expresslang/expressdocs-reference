{% if things.size > 0 %}
{% assign entities_title = schema_id | append: " entity definitions" %}

{% include "basic_title", thing_prefix: thing_prefix, anchor: "entities", title: entities_title, depth: depth %}

{% for thing in things %}
{% assign entity_nested_depth = depth | plus: 1 %}

{% include "entity", thing: thing, thing_prefix: thing_prefix, depth: entity_nested_depth %}

{% endfor %}

{% endif %}
