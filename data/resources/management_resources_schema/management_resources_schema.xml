      x := QUERY(aor
                 &lt;* bag_to_set(USEDIN(relation.relating, 'MANAGEMENT_RESOURCES_SCHEMA.ASSIGNMENT_OBJECT_RELATIONSHIP.RELATED'))
                 | specific_relation IN TYPEOF(aor));
