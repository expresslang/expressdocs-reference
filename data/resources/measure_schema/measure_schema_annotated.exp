see ISO 1000;

[NOTE]
--
ISO 1000 gives "kilogram" as the SI unit name. This part of ISO 10303 uses "gram" as the SI unit name.
--
*)

(*"measure_schema.si_unit_name.second"
see ISO 1000;
*)

(*"measure_schema.si_unit_name.ampere"
see ISO 1000;
*)

(*"measure_schema.si_unit_name.kelvin"
see ISO 1000;
*)

(*"measure_schema.si_unit_name.mole"
see ISO 1000;
*)

(*"measure_schema.si_unit_name.candela"
see ISO 1000;
*)

