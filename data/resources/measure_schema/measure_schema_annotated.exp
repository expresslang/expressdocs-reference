see ISO 1000;
*)

(*"measure_schema.si_prefix.tera"
see ISO 1000;
*)

(*"measure_schema.si_prefix.giga"
see ISO 1000;
*)

(*"measure_schema.si_prefix.mega"
see ISO 1000;
*)

(*"measure_schema.si_prefix.kilo"
see ISO 1000;
*)

(*"measure_schema.si_prefix.hecto"
see ISO 1000;
*)

(*"measure_schema.si_prefix.deca"
see ISO 1000;
*)

(*"measure_schema.si_prefix.deci"
see ISO 1000;
*)

(*"measure_schema.si_prefix.centi"
see ISO 1000;
*)

(*"measure_schema.si_prefix.milli"
see ISO 1000;
*)

(*"measure_schema.si_prefix.micro"
see ISO 1000;
*)

(*"measure_schema.si_prefix.nano"
see ISO 1000;
*)

(*"measure_schema.si_prefix.pico"
see ISO 1000;
*)

(*"measure_schema.si_prefix.femto"
see ISO 1000;
*)

(*"measure_schema.si_prefix.atto"
see ISO 1000.
*)

(*"measure_schema.si_unit_name"
An *si\_unit\_name* is the name of an SI unit. 

[NOTE]
--
The definitions of the names of SI units are specified in ISO 1000.
--
*)

(*"measure_schema.si_unit_name.metre"
see ISO 1000;
*)

